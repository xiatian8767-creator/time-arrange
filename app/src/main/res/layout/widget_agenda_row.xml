<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginBottom="8dp" android:padding="10dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row_blue">
    <LinearLayout android:layout_width="57dp" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" />
        <TextView android:id="@+id/widget_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:layout_marginTop="5dp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/widget_divider" android:layout_width="1dp" android:layout_height="38dp" android:layout_marginRight="12dp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:layout_marginTop="5dp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/widget_badge" android:layout_width="37dp" android:layout_height="23dp" android:layout_marginLeft="6dp" android:gravity="center" android:textSize="10sp" android:background="@drawable/widget_badge_blue" />
</LinearLayout>
