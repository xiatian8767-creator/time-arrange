<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#647fdc</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#f7f5ef</item>
        <item name="android:navigationBarColor">#f7f5ef</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#f7f5ef</item>
    </style>
    <style name="AlarmTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#EAC987</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
